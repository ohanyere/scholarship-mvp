# Application
APP_ENV=local
LOG_LEVEL=info

# API
API_PORT=8080
API_BASE_URL=http://localhost:8080
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL=15m

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scholarship_platform
POSTGRES_USER=scholarship_platform
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

# Local Docker Compose PostgreSQL
# These values are reused by the local postgres container and the API.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SCHOLARSHIPS=5m

# AI
AI_PROVIDER=openai
AI_API_KEY=change-me
AI_MODEL=gpt-5.4-mini

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
